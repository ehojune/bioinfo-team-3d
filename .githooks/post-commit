#!/bin/sh
# post-commit 훅 — 이 저장소는 core.hooksPath=.githooks 를 쓰므로 머신 전역 훅(~/.git-template/hooks)이 돌지 않는다.
# 전역 post-commit 이 있으면 그리로 넘긴다. 전역 훅은 에이전트 세션의 커밋 author/committer 를 그 에이전트의
# GitHub App 봇(claude-ehojune[bot] 등)으로 바꾼다(amend). 없는 머신에서는 아무것도 하지 않는다. 항상 exit 0.
# Replay keeps the original author, even inside an agent session. --git-path
# resolves per-worktree state too (a linked worktree has no .git directory).
for state in CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer; do
  path=$(git rev-parse --git-path "$state" 2>/dev/null) || exit 0
  [ -e "$path" ] && exit 0
done
# A conflicted cherry-pick clears CHERRY_PICK_HEAD before post-commit runs.
# Delegate only a known new commit/amend; without reflogs preserve identity.
[ "$(git config --bool core.logAllRefUpdates)" = false ] && exit 0
action=$(git reflog -1 --format=%gs 2>/dev/null) || exit 0
case "$action" in
  commit:\ *|commit\ \(initial\):\ *|commit\ \(amend\):\ *) ;;
  *) exit 0 ;;
esac
G="$HOME/.git-template/hooks/post-commit"
if [ -x "$G" ]; then "$G" "$@"; fi
exit 0
