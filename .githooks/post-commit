#!/bin/sh
# post-commit 훅 — 이 저장소는 core.hooksPath=.githooks 를 쓰므로 머신 전역 훅(~/.git-template/hooks)이 돌지 않는다.
# 전역 post-commit 이 있으면 그리로 넘긴다. 전역 훅은 에이전트 세션의 커밋 author/committer 를 그 에이전트의
# GitHub App 봇(claude-ehojune[bot] 등)으로 바꾼다(amend). 없는 머신에서는 아무것도 하지 않는다. 항상 exit 0.
G="$HOME/.git-template/hooks/post-commit"
if [ -x "$G" ]; then "$G" "$@"; fi
exit 0
